# Required: Anthropic API key for the tutoring model
ANTHROPIC_API_KEY=

# Optional: model used for tutoring replies (default: claude-sonnet-5-5)
# TUTOR_MODEL=claude-sonnet-5-5

# Required for web lookups: API key for the search provider (Brave Search by default).
# Leave blank to run without web search.
WEB_SEARCH_API_KEY=

# Optional: override the search endpoint if using a different provider
# WEB_SEARCH_URL=https://api.search.brave.com/res/v1/web/search

# Optional: SQLite file for student profiles and course material
# DATABASE_PATH=tutor.db
